Subject: [PATCH 7/9] mm: mglru: preserve the successful generation CAS page type

Adapted for the page-based 5.15 MGLRU implementation from:
https://github.com/torvalds/linux/commit/766f584cb6270dadce62c40c0cd4327aff7d531a

Capture PG_swapbacked from the old flags of the successful CAS. Pass that
type to batched accounting instead of rereading live flags after a possible
LRU del/add type transition. Preserve the LRU-lock-protected direct path.

This is a new reconstruction from published rc1 sources and the recorded
rc3 change description, not a recovered historical rc3 artifact.

diff --git a/mm/vmscan.c b/mm/vmscan.c
index 7b58e5763..6d2cc32e4 100644
--- a/mm/vmscan.c
+++ b/mm/vmscan.c
@@ -3502,7 +3502,7 @@ static bool positive_ctrl_err(struct ctrl_pos *sp, struct ctrl_pos *pv)
  ******************************************************************************/
 
 /* promote pages accessed through page tables */
-static int page_update_gen(struct page *page, int gen)
+static int page_update_gen(struct page *page, int gen, int *type)
 {
 	unsigned long new_flags, old_flags = READ_ONCE(page->flags);
 
@@ -3521,6 +3521,8 @@ static int page_update_gen(struct page *page, int gen)
 		new_flags |= (gen + 1UL) << LRU_GEN_PGOFF;
 	} while (!try_cmpxchg(&page->flags, &old_flags, new_flags));
 
+	/* Account using the same anon/file state as the successful CAS. */
+	*type = !(old_flags & BIT(PG_swapbacked));
 	return ((old_flags & LRU_GEN_MASK) >> LRU_GEN_PGOFF) - 1;
 }
 
@@ -3555,9 +3557,8 @@ static int page_inc_gen(struct lruvec *lruvec, struct page *page, bool reclaimin
 }
 
 static void update_batch_size(struct lru_gen_mm_walk *walk, struct page *page,
-			      int old_gen, int new_gen)
+			      int old_gen, int new_gen, int type)
 {
-	int type = page_is_file_lru(page);
 	int zone = page_zonenum(page);
 	int delta = thp_nr_pages(page);
 
@@ -3747,7 +3748,7 @@ static bool walk_pte_range(pmd_t *pmd, unsigned long start, unsigned long end,
 	struct lru_gen_mm_walk *walk = args->private;
 	struct mem_cgroup *memcg = lruvec_memcg(walk->lruvec);
 	struct pglist_data *pgdat = lruvec_pgdat(walk->lruvec);
-	int old_gen, new_gen = lru_gen_from_seq(walk->max_seq);
+	int type, old_gen, new_gen = lru_gen_from_seq(walk->max_seq);
 
 	VM_WARN_ON_ONCE(pmd_leaf(*pmd));
 
@@ -3790,9 +3791,9 @@ static bool walk_pte_range(pmd_t *pmd, unsigned long start, unsigned long end,
 		      !PageSwapCache(page)))
 			set_page_dirty(page);
 
-		old_gen = page_update_gen(page, new_gen);
+		old_gen = page_update_gen(page, new_gen, &type);
 		if (old_gen >= 0 && old_gen != new_gen)
-			update_batch_size(walk, page, old_gen, new_gen);
+			update_batch_size(walk, page, old_gen, new_gen, type);
 	}
 
 	if (i < PTRS_PER_PTE && get_next_vma(PMD_MASK, PAGE_SIZE, args, &start, &end))
@@ -3816,7 +3817,7 @@ static void walk_pmd_range_locked(pud_t *pud, unsigned long next, struct vm_area
 	struct lru_gen_mm_walk *walk = args->private;
 	struct mem_cgroup *memcg = lruvec_memcg(walk->lruvec);
 	struct pglist_data *pgdat = lruvec_pgdat(walk->lruvec);
-	int old_gen, new_gen = lru_gen_from_seq(walk->max_seq);
+	int type, old_gen, new_gen = lru_gen_from_seq(walk->max_seq);
 
 	VM_WARN_ON_ONCE(pud_leaf(*pud));
 
@@ -3870,9 +3871,9 @@ static void walk_pmd_range_locked(pud_t *pud, unsigned long next, struct vm_area
 		      !PageSwapCache(page)))
 			set_page_dirty(page);
 
-		old_gen = page_update_gen(page, new_gen);
+		old_gen = page_update_gen(page, new_gen, &type);
 		if (old_gen >= 0 && old_gen != new_gen)
-			update_batch_size(walk, page, old_gen, new_gen);
+			update_batch_size(walk, page, old_gen, new_gen, type);
 next:
 		i = i > MIN_LRU_BATCH ? 0 : find_next_bit(bitmap, MIN_LRU_BATCH, i) + 1;
 	} while (i <= MIN_LRU_BATCH);
@@ -4463,7 +4464,7 @@ void lru_gen_look_around(struct page_vma_mapped_walk *pvmw)
 	struct pglist_data *pgdat = page_pgdat(page);
 	struct lruvec *lruvec = mem_cgroup_lruvec(memcg, pgdat);
 	DEFINE_MAX_SEQ(lruvec);
-	int old_gen, new_gen = lru_gen_from_seq(max_seq);
+	int type, old_gen, new_gen = lru_gen_from_seq(max_seq);
 
 	lockdep_assert_held(pvmw->ptl);
 	VM_WARN_ON_ONCE_PAGE(PageLRU(page), page);
@@ -4553,12 +4554,12 @@ void lru_gen_look_around(struct page_vma_mapped_walk *pvmw)
 		if (page_memcg_rcu(page) != memcg)
 			continue;
 
-		old_gen = page_update_gen(page, new_gen);
+		old_gen = page_update_gen(page, new_gen, &type);
 		if (old_gen < 0 || old_gen == new_gen)
 			continue;
 
 		if (walk)
-			update_batch_size(walk, page, old_gen, new_gen);
+			update_batch_size(walk, page, old_gen, new_gen, type);
 		else
 			lru_gen_update_size(lruvec, page, old_gen, new_gen);
 	}
